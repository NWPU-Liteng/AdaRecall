# Runtime logs; keep documentation in the log directory
/agent-memory-profiling/logs/*.log

# Only the canonical v21 implementation is maintained in Git. Historical
# experiment packages are represented by versions/INDEX.md and v21 provenance.
/agent-memory-profiling/versions/*/
!/agent-memory-profiling/versions/20260714_method1_fsa_dynamic_hypergraph_v21/
!/agent-memory-profiling/versions/motivation_experiments/

# Keep the PRISM-aligned v24 implementation and small audit manifests in Git;
# generated dataset/model/run payloads remain external artifacts.
!/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v24/
!/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v24/**/
/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v24/inputs/
/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v24/runs/
/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v24/artifacts/environment/
/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v24/artifacts/models/
/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v24/artifacts/hypergraph/
/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v24/figures/

# Keep the v25 development-only optimization code and compact closure evidence;
# per-query reranker rows remain generated artifacts.
!/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v25/
!/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v25/**/
/agent-memory-profiling/versions/20260718_prism_aligned_method1_closure_v25/runs/

# Keep motivation documentation, source, configs, reports, and figures while
# excluding its archived data products and formal-run payloads.
/agent-memory-profiling/versions/motivation_experiments/**/aggregate/
/agent-memory-profiling/versions/motivation_experiments/**/artifacts/
/agent-memory-profiling/versions/motivation_experiments/**/datasets/
/agent-memory-profiling/versions/motivation_experiments/**/logs/
/agent-memory-profiling/versions/motivation_experiments/**/manifests/
/agent-memory-profiling/versions/motivation_experiments/**/outputs/
/agent-memory-profiling/versions/motivation_experiments/**/runs/

# Reproducible or externally stored v21 data products. Source, tests, configs,
# reports, and orchestration scripts in the canonical package remain tracked.
/agent-memory-profiling/versions/20260714_method1_fsa_dynamic_hypergraph_v21/aggregate/
/agent-memory-profiling/versions/20260714_method1_fsa_dynamic_hypergraph_v21/artifacts/
